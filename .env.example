# Supabase público: se incluye en el bundle del navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase privado: solo para rutas y páginas de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Acceso al panel privado.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# URL canónica de producción, por ejemplo https://www.wonlyspain.com
NEXT_PUBLIC_SITE_URL=
